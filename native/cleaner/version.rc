#include <windows.h>
#include "maple_version.h"
1 VERSIONINFO
 FILEVERSION MAPLE_VERSION_QUAD
 PRODUCTVERSION MAPLE_VERSION_QUAD
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "Tuan-Space"
   VALUE "FileDescription", "CuteMaple Native Memory Cleaner"
   VALUE "FileVersion", MAPLE_VERSION_FILE
   VALUE "InternalName", "CuteMaple-Cleaner"
   VALUE "OriginalFilename", "CuteMaple-Cleaner.exe"
   VALUE "ProductName", "CuteMaple"
   VALUE "ProductVersion", MAPLE_VERSION
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
